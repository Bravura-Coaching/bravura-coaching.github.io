---
import '../styles/testimonials.scss';

const testimonials = [
  {
    id: '1',
    person: 'N J Jones, Salisbury',
    description: 'Emma’s lessons are fun, sensitive to the needs and personalities of her students and produce great results. She is a warm and patient teacher who knows how to bring out the best in people and is a passionate advocate for music education. We feel very lucky to have found her.'
  },
  {
    id: '2',
    person: 'Victoria, London',
    description: 'Learning with Emma has been an inspiring experience. She nurtures each student with patience and insight, and she encourages me to discover not only my musical potential but also a genuine love of creating music. Through her teaching, I have found a greater sense of joy, confidence and fulfilment in my musical journey, feeling encouraged to grow and flourish in my own unique way.'
  }
];
---

<section class="testimonials" id="testimonials">
  <div class="testimonials-header">
    <h2 class="testimonials-title">Testimonials</h2>
  </div>
  <div class="testimonials-container">
    {testimonials.map((testimonial) => (
      <div class="testimonials-card">
        <div class="testimonials-content">
          <h3 class="testimonials-description">{testimonial.person}</h3>
          <p class="testimonials-description"><i>{testimonial.description}</i></p>
        </div>
      </div>
    ))}
  </div>
</section>
