---
import '../styles/fees.scss';

const tiers = [
  {
    id: 'introductory',
    level: 'Introductory',
    description: 'Discovery Call & 30min Instrumental Session',
    details: [
      'Includes a 20min Discovery Call',
      'Includes a 30min Online Instrumental Session to get you started'
    ],
    benefit: 'Get connected with how music helps you thrive',
    price: '£35',
    link: 'https://calendly.com/emma-sjacob/introductory-session'
  },
  {
    id: 'intermediate',
    level: 'Beginner/Intermediate',
    description: 'Beginner/Intermediate package of 5 x 1hr sessions.',
    details: [
      'Includes 4 x 60min Online Sessions',
      'Includes 1 x 60min Face to Face Session'
    ],
    benefit: 'Start your musical journey to richer/better/stronger wellbeing and progress your playing skills',
    price: '£350',
    link: 'https://calendly.com/emma-sjacob/1-hour-lesson-one-to-one-in-person'
  },
  {
    id: 'bespoke',
    level: 'Bespoke',
    description: 'Bespoke individual sessions, face to face or online',
    details: [
      'Includes individual online sessions',
      'Includes individual face to face sessions',
      'Small group sessions are available on request'
    ],
    benefit: 'Take your string playing and wellbeing to the next level with advanced tuition and deeper connection with your life goals.',
    price: '£80/1hr',
    link: 'https://calendly.com/emma-sjacob/30min'
  }
];
---

<section class="fees" id="fees">
  <div class="fees-header">
    <h2 class="fees-title">Prices & Packages</h2>
  </div>
  <div class="fees-container">
    {tiers.map((tier) => (
      <div class="fee-card">
        <div class="fee-content">
          <h3 class="fee-level">{tier.level}</h3>
          <p class="fee-description">{tier.description}</p>
          <details class="fee-details">
            <summary>See more</summary>
            <ul class="fee-details-text">
              {tier.details.map((detail) => <li>{detail}</li>)}
            </ul>
          </details>
          <p class="fee-benefit">{tier.benefit}</p>
        </div>
        <div class="fee-footer">
          <a
            class="book-now"
            href={tier.link}
            onclick={`window.open('${tier.link}', 'bookingWindow', 'width=900,height=750,resizable=yes,scrollbars=yes'); return false;`}
          >
            Book Now
          </a>
          <span class="fee-price">{tier.price}</span>
        </div>
      </div>
    ))}
  </div>
</section>
