---
// Import astro functions
import { getImage } from 'astro:assets';
// Import images and resources
import heroBg from '../assets/images/hero-bg.jpg';
import Navbar from '../components/Navbar.astro';
import '../styles/hero.scss';

// Javascript code
const bg = await getImage({ src: heroBg, format: 'webp' });
---
<section class="hero" id="hero" style={`--bg-url: url(${bg.src})`}>
    <Navbar />
    <h1>BRAVURA</h1>
    <h2>Nourish your brain<br/>Play music</h2>
    <h2 class="quote">"When we play an instrument, we are engaging more mental facilities than almost any other activity"</h2>
</section>